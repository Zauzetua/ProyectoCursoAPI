# ==========================================
# .gitignore para ASP.NET Core Web API
# ==========================================

# 1. Archivos de compilación y publicación
[Bb]in/
[Oo]bj/
[Oo]ut/
publish/
*.publishproj

# 2. Entornos de desarrollo locales (IDEs)
# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider
.idea/
*.sln.iml

# 3. Archivos temporales y cachés locales
*.cache
*.tmp
*.log
[Ll]ogs/

# 4. Resultados de pruebas y cobertura
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.coveragexml
TestResults/
coverage/

# 5. Paquetes y dependencias (NuGet)
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# 6. Variables de entorno y secretos locales
# Descomenta la siguiente línea si no quieres compartir la configuración de desarrollo
# appsettings.Development.json
*.env
*.env.local
secrets.json

# 7. Archivos de bases de datos locales (Entity Framework / SQLite)
*.mdf
*.ldf
*.ndf
*.db
*.db-shm
*.db-wal

# 8. Archivos generados por el sistema operativo
.DS_Store
Thumbs.db