@model ProyectoCursoAPI.Web.Models.Categorias.CategoriaFormViewModel

<div class="modal-header bg-dark text-white">
    <h5 class="modal-title" id="genericModalLabel">
        <i class="bi @(Model.EsEdicion ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
        @(Model.EsEdicion ? "Editar Categoria" : "Nueva Categoria")
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="categoriaModalForm" asp-controller="Categorias" asp-action="@(Model.EsEdicion ? "Edit" : "Create")" method="post" onsubmit="return CrudHelper.submitModalForm(this, refrescarTablaCategorias);">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="modal-body p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label fw-semibold"></label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. Laptops, Monitores, etc." autofocus />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label fw-semibold"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripcion detallada de la categoria"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger small"></span>
        </div>
    </div>

    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-1"></i>Guardar
        </button>
    </div>
</form>
