@model ProyectoCursoAPI.Web.Models.Categorias.CategoriaIndexViewModel

<div class="table-responsive">
    <table class="table table-hover align-middle table-striped table-bordered mb-0">
        <thead class="table-dark">
            <tr>
                <th style="width: 35%;">Nombre</th>
                <th style="width: 50%;">Descripcion</th>
                <th style="width: 15%;" class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PagedResult.Items.Any())
            {
                @foreach (var item in Model.PagedResult.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.Nombre</td>
                        <td class="text-muted">@(string.IsNullOrEmpty(item.Descripcion) ? "-" : item.Descripcion)</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-outline-primary btn-sm me-1 btn-edit-categoria" data-id="@item.Id" title="Editar">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm btn-delete-categoria" data-id="@item.Id" data-name="@item.Nombre" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">
                        <i class="bi bi-inbox display-6 d-block mb-2"></i>
                        No se encontraron categorias registradas.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted small">
        Mostrando pagina @Model.Pagination.CurrentPage de @Model.Pagination.TotalPages (Total: @Model.Pagination.TotalCount registros)
    </span>
    <partial name="_Pagination" model="Model.Pagination" />
</div>
