@{
    ViewData["Title"] = "Inicio";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm text-center">
    <div class="container-fluid py-5">
        <h1 class="display-5 fw-bold text-dark">Bienvenido a AssetManager</h1>
        <p class="col-md-8 fs-4 mx-auto text-muted">
            Sistema administrativo desarrollado con ASP.NET Core MVC bajo principios de Clean Architecture y vistas integradas con modales asincronos.
        </p>
        <div class="mt-4">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4 me-2">
                <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar Sesion
            </a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary btn-lg px-4">
                <i class="bi bi-person-plus me-1"></i>Crear Cuenta
            </a>
        </div>
    </div>
</div>
