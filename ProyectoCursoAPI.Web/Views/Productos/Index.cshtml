@model ProyectoCursoAPI.Web.Models.Productos.ProductoIndexViewModel
@{
    ViewData["Title"] = "Gestion de Productos";
}

<!-- Token antiforgery para peticiones AJAX de borrado -->
@Html.AntiForgeryToken()

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-0 fw-bold text-dark"><i class="bi bi-tag me-2 text-primary"></i>Productos</h4>
            <span class="text-muted small">Administracion completa en una sola vista mediante modales asincronos</span>
        </div>
        <div>
            <button type="button" class="btn btn-primary" id="btnNuevoProducto">
                <i class="bi bi-plus-lg me-1"></i>Nuevo Producto
            </button>
        </div>
    </div>
    <div class="card-body">
        <!-- Contenedor dinamico de la tabla con atributos para paginacion AJAX -->
        <div id="productosTableContainer" data-ajax-table="true" data-table-url="@Url.Action("GetTable", "Productos")">
            <partial name="_TablePartial" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    <script>
        /**
         * Refresca el contenido de la tabla de productos via AJAX
         */
        function refrescarTablaProductos() {
            var url = $('#productosTableContainer').data('table-url');
            CrudHelper.loadTable('#productosTableContainer', url);
        }

        $(document).ready(function () {
            // Abrir modal de creacion
            $('#btnNuevoProducto').on('click', function () {
                var url = '@Url.Action("GetCreateModal", "Productos")';
                CrudHelper.openModal(url);
            });

            // Abrir modal de edicion
            $(document).on('click', '.btn-edit-producto', function () {
                var id = $(this).data('id');
                var url = '@Url.Action("GetEditModal", "Productos")' + '?id=' + id;
                CrudHelper.openModal(url);
            });

            // Abrir modal de eliminacion logica
            $(document).on('click', '.btn-delete-producto', function () {
                var id = $(this).data('id');
                var name = $(this).data('name');
                var url = '@Url.Action("Delete", "Productos")';
                var token = $('input[name="__RequestVerificationToken"]').first().val();

                CrudHelper.confirmDelete(
                    url,
                    id,
                    token,
                    'Esta seguro de que desea eliminar el producto "' + name + '"?',
                    refrescarTablaProductos
                );
            });
        });
    </script>
}
