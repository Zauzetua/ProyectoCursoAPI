@model ProyectoCursoAPI.Web.Models.Productos.ProductoFormViewModel

<div class="modal-header bg-dark text-white">
    <h5 class="modal-title" id="genericModalLabel">
        <i class="bi @(Model.EsEdicion ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
        @(Model.EsEdicion ? "Editar Producto" : "Nuevo Producto")
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="productoModalForm" asp-controller="Productos" asp-action="@(Model.EsEdicion ? "Edit" : "Create")" method="post" onsubmit="return CrudHelper.submitModalForm(this, refrescarTablaProductos);">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="modal-body p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label fw-semibold"></label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. Laptop Dell Latitude 5420" autofocus />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label fw-semibold"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Especificaciones tecnicas del producto"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Precio" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="Precio" type="number" step="0.01" class="form-control" placeholder="0.00" />
                </div>
                <span asp-validation-for="Precio" class="text-danger small"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Stock" class="form-label fw-semibold"></label>
                <input asp-for="Stock" type="number" class="form-control" placeholder="0" />
                <span asp-validation-for="Stock" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="IdCategoria" class="form-label fw-semibold"></label>
                <select asp-for="IdCategoria" asp-items="Model.CategoriasList" class="form-select">
                    <option value="">-- Seleccione una Categoria --</option>
                </select>
                <span asp-validation-for="IdCategoria" class="text-danger small"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="IdProveedor" class="form-label fw-semibold"></label>
                <select asp-for="IdProveedor" asp-items="Model.ProveedoresList" class="form-select">
                    <option value="">-- Seleccione un Proveedor --</option>
                </select>
                <span asp-validation-for="IdProveedor" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-1"></i>Guardar
        </button>
    </div>
</form>
