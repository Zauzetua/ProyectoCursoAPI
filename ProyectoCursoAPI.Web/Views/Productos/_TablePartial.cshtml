@model ProyectoCursoAPI.Web.Models.Productos.ProductoIndexViewModel

<div class="table-responsive">
    <table class="table table-hover align-middle table-striped table-bordered mb-0">
        <thead class="table-dark">
            <tr>
                <th style="width: 25%;">Producto</th>
                <th style="width: 15%;">Categoria</th>
                <th style="width: 20%;">Proveedor</th>
                <th style="width: 12%;" class="text-end">Precio</th>
                <th style="width: 10%;" class="text-center">Stock</th>
                <th style="width: 18%;" class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PagedResult.Items.Any())
            {
                @foreach (var item in Model.PagedResult.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.Nombre</div>
                            <small class="text-muted text-truncate d-block" style="max-width: 250px;">@item.Descripcion</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-tag me-1"></i>@item.CategoriaNombre
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-truck me-1"></i>@item.ProveedorNombreComercial
                            </span>
                        </td>
                        <td class="text-end fw-bold">@item.Precio.ToString("C2")</td>
                        <td class="text-center">
                            @if (item.Stock > 5)
                            {
                                <span class="badge bg-success">@item.Stock</span>
                            }
                            else if (item.Stock > 0)
                            {
                                <span class="badge bg-warning text-dark">@item.Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Agotado</span>
                            }
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-outline-primary btn-sm me-1 btn-edit-producto" data-id="@item.Id" title="Editar">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm btn-delete-producto" data-id="@item.Id" data-name="@item.Nombre" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        <i class="bi bi-inbox display-6 d-block mb-2"></i>
                        No se encontraron productos registrados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted small">
        Mostrando pagina @Model.Pagination.CurrentPage de @Model.Pagination.TotalPages (Total: @Model.Pagination.TotalCount registros)
    </span>
    <partial name="_Pagination" model="Model.Pagination" />
</div>
