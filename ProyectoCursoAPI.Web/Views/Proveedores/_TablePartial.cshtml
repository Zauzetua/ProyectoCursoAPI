@model ProyectoCursoAPI.Web.Models.Proveedores.ProveedorIndexViewModel

<div class="table-responsive">
    <table class="table table-hover align-middle table-striped table-bordered mb-0">
        <thead class="table-dark">
            <tr>
                <th style="width: 20%;">Nombre Comercial</th>
                <th style="width: 15%;">RFC</th>
                <th style="width: 20%;">Email</th>
                <th style="width: 15%;">Telefono</th>
                <th style="width: 15%;">Direccion</th>
                <th style="width: 15%;" class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PagedResult.Items.Any())
            {
                @foreach (var item in Model.PagedResult.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.NombreComercial</td>
                        <td><code>@item.RFC</code></td>
                        <td><a href="mailto:@item.Email" class="text-decoration-none">@item.Email</a></td>
                        <td>@item.Telefono</td>
                        <td class="text-truncate" style="max-width: 180px;" title="@item.Direccion">@item.Direccion</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-outline-primary btn-sm me-1 btn-edit-proveedor" data-id="@item.Id" title="Editar">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm btn-delete-proveedor" data-id="@item.Id" data-name="@item.NombreComercial" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        <i class="bi bi-inbox display-6 d-block mb-2"></i>
                        No se encontraron proveedores registrados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted small">
        Mostrando pagina @Model.Pagination.CurrentPage de @Model.Pagination.TotalPages (Total: @Model.Pagination.TotalCount registros)
    </span>
    <partial name="_Pagination" model="Model.Pagination" />
</div>
