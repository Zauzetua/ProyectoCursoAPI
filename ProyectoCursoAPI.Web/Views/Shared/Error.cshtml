@model ProyectoCursoAPI.Web.Models.Shared.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-md-8 text-center py-5">
        <i class="bi bi-exclamation-octagon text-danger display-1 mb-3"></i>
        <h2 class="text-danger fw-bold">Ocurrio un problema</h2>
        <p class="lead text-muted">@Model?.Message</p>

        @if (Model != null && Model.ShowRequestId)
        {
            <p class="text-muted small">
                <strong>ID de Peticion:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
            <i class="bi bi-house me-1"></i>Volver al Inicio
        </a>
    </div>
</div>
