@model ProyectoCursoAPI.Web.Models.Shared.PaginationInfo

@if (Model != null && Model.TotalPages > 1)
{
    <nav aria-label="Navegacion de paginas">
        <ul class="pagination pagination-sm justify-content-end mb-0">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" href="#" data-page="@(Model.CurrentPage - 1)">Anterior</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="#" data-page="@i">@i</a>
                </li>
            }

            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" href="#" data-page="@(Model.CurrentPage + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}
